<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Program.cs" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="$(EngineBin)/*.dll" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <Target Name="RequireEngineBin" BeforeTargets="ResolveReferences" Condition="'$(EngineBin)' == ''">
    <Error Text="Set -p:EngineBin to an existing TensorSharp host or test output directory." />
  </Target>
</Project>
